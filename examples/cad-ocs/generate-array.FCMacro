import FreeCAD as App
import Draft
import Import
import Part

# Run from the repository root in FreeCAD 1.1.3.
doc = App.newDocument("RectangularArray")
seed = doc.addObject("Part::Feature", "Seed")
seed.Shape = Part.makePolygon([App.Vector(2, 3, 0), App.Vector(5, 3, 0), App.Vector(5, 5, 0)])
doc.recompute()
array = Draft.make_ortho_array(seed, App.Vector(7, 0, 0), App.Vector(0, 11, 0), App.Vector(0, 0, 1), 3, 2, 1)
doc.recompute()
seed.Visibility = False
doc.saveAs("examples/cad-ocs/rectangular-array.FCStd")
Import.writeDXFObject([array], "examples/cad-ocs/rectangular-array.dxf", 12, False, "User parameter:DXFKitCADR12")
App.closeDocument(doc.Name)
