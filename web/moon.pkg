import {
  "mik1e80/dxfkit",
  "moonbitlang/core/encoding/base64",
}

// 编译成浏览器能直接 <script src> 加载的 JS。
//
// - web.mbt 的 #export_name 声明浏览器所需的全局函数。
// - format: "iife"：包成一个立即执行函数，函数名挂到全局。
//   默认的 "esm" 在 file:// 下会被 CORS 拦掉，页面就不能双击打开了

options(
  link: { "js": { "format": "iife" } },
)

pkgtype(kind: "foreign_library")
